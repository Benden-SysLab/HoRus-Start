{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StorageRuntimeObject",
  "description": "JSON Schema for HoRus-Start Runtime API v1 Storage State Objects",
  "type": "object",
  "required": ["api_version", "schema_version", "producer", "resource_type", "stage", "step", "timestamp", "nodes"],
  "properties": {
    "api_version": {
      "type": "string",
      "enum": ["v1"]
    },
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "producer": {
      "type": "string"
    },
    "resource_type": {
      "type": "string",
      "enum": ["storage"]
    },
    "stage": {
      "type": "integer"
    },
    "step": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "nodes": {
      "type": "object"
    }
  }
}
