{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stage0ReadinessReport",
  "description": "JSON Schema for HoRus-Start Runtime API v1 Stage 0 Readiness Gate Report",
  "type": "object",
  "required": ["api_version", "schema_version", "producer", "resource_type", "stage", "status", "timestamp", "checks"],
  "properties": {
    "api_version": {
      "type": "string",
      "enum": ["v1"]
    },
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "producer": {
      "type": "string",
      "enum": ["stage0_readiness_gate"]
    },
    "resource_type": {
      "type": "string",
      "enum": ["report"]
    },
    "stage": {
      "type": "integer",
      "enum": [0]
    },
    "status": {
      "type": "string",
      "enum": ["READY", "WAITING_USER_INPUT", "FAILED"]
    },
    "timestamp": {
      "type": "string"
    },
    "checks": {
      "type": "object",
      "required": ["ssh_identity"],
      "properties": {
        "ssh_identity": { "type": "string", "enum": ["PASS", "FAIL"] }
      }
    },
    "generated_templates": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blocking_items": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
